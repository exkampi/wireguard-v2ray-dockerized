{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "wireguard",
      "port": 51820,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "10.13.13.2",
        "port": 51820,
        "network": "udp"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
