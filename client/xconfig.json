{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "tag": "wg",
      "port": 51820,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "wg",
        "port": 51820,
        "network": "udp"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "${SERVER_ADDRESS}",
            "port": 443,
            "users": [
              {
                "id": "${CLIENT_UUID}",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "chrome",
          "serverName": "www.google.com",
          "publicKey": "${PUBLIC_KEY}",
          "spiderX": ""
        }
      },
      "tag": "proxy"
    }
  ]
}